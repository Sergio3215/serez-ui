// effect.sz — Efectos secundarios para componentes serez-ui
//
// Nota: 'fn' es keyword en serez-code. El parámetro se llama 'handler'.

export public class EffectCell {
    public EffectCell(any handler, any deps) {
        this.handler  = handler
        this.deps     = deps
        this.prevDeps = null
        this.cleanup  = null
        this.ran      = false
    }

    // Los deps VIVOS se resuelven en cada corrida.
    //
    // En React `useEffect(fn, [x])` se vuelve a evaluar en cada render, así que
    // `[x]` siempre trae el valor actual. Acá el efecto se registra UNA vez
    // (`addEffect`), así que un array literal queda congelado en el valor que
    // tenía al registrarlo: `deps [this.id]` se quedaba en `[1]` para siempre y
    // el tercer modo de useEffect —"corré cuando esto cambie"— no funcionaba, en
    // silencio. Pasando una FUNCIÓN que devuelve el array, se evalúa cada vez.
    //
    //   useEffect(fn, [this.id])        → congelado (sólo sirve si nunca cambia)
    //   useEffect(fn, () => [this.id])  → vivo, es el equivalente real de React
    public any depsAhora() {
        if (type_of(this.deps) == "function") { return this.deps(); }
        return this.deps
    }

    public void run() {
        let actuales = this.depsAhora()
        let should = false
        if (!this.ran) {
            should = true
        } else if (actuales == null) {
            should = true
        } else {
            should = this.depsChangedCon(actuales)
        }

        if (should) {
            if (this.cleanup != null) {
                this.cleanup()
            }
            let result = this.handler()
            if (result != null) {
                this.cleanup = result
            }
            this.prevDeps = actuales
            this.ran = true
        }
    }

    public void forceRun() {
        this.ran = false
        this.run()
    }

    public void dispose() {
        if (this.cleanup != null) {
            this.cleanup()
            this.cleanup = null
        }
        this.ran = false
        this.prevDeps = null
    }

    public bool depsChangedCon(any actuales) {
        if (this.prevDeps == null) { return true; }
        if (this.prevDeps.length() != actuales.length()) { return true; }
        let i = 0
        while (i < actuales.length()) {
            if (actuales[i] != this.prevDeps[i]) { return true; }
            i = i + 1
        }
        return false
    }

    public bool depsChanged() {
        return this.depsChangedCon(this.depsAhora())
    }
}

// useEffect(handler, deps) → EffectCell
// handler — función sin args que retorna cleanup fn o null
// deps    — array de dependencias; [] = solo en mount; null = siempre
export fn any useEffect(any handler, any deps) {
    return new EffectCell(handler, deps)
}
