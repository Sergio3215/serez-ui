// component.sz — Componentes reutilizables de serez-ui (estilo React)
//
// Un Component recibe `props` (datos que le pasa quien lo usa) y `children`
// (el contenido entre sus tags). Extiende Window, así que hereda render/mount/
// update/diff y el manejo de efectos.
//
//   class TaskRow:Component {
//       public TaskRow() { super() }
//       render() {
//           return (
//               <li>{this.props.name}</li>   // el translator reescribe .props.name → ["name"]
//           )
//       }
//   }
//
//   // uso:  <TaskRow name="buy milk" />
//
// props y children NO se reciben en el constructor: el framework los inyecta
// con _init() justo después de `new` (lo hace __renderComponent, que es lo que
// emite el translator). Esto deja el constructor del usuario limpio, al estilo
// React donde props "aparecen" disponibles.

import "window"
import "h"

export public class Component:Window {
    public Component() {
        super()
        this.props    = __makeProps([])   // dict vacío hasta que el framework inyecte
        this.children = []
        // Puerto de estado: un closure que el DUEÑO fabrica en su propio render()
        // y nos pasa. Ver useState más abajo y __renderComponent.
        this.__port   = null
        this.__slot   = 0
        this.__hook   = 0
    }

    // Llamado por el framework (vía __renderComponent) tras instanciar.
    public void _init(any props, any children) {
        this.props    = props
        this.children = children
    }

    // ── El puerto se REENVÍA hacia arriba ────────────────────────────────────
    //
    // Un Component hereda __hookPort de Window, pero NO puede usar su propio
    // store: la instancia es efímera y se tira en cada frame. Cuando este
    // componente renderiza a otro, el puerto que el traductor emitió captura
    // ESTA instancia, así que hay que reenviar la llamada al puerto que nos dio
    // nuestro propio dueño, hasta llegar a la Window raíz, que sí persiste.
    //
    // El slot se prefija con el propio para que dos instancias del mismo
    // componente padre no le pisen el estado a sus hijos.
    public any __hookPort(any slot, int op, any k, any v) {
        let port = this.__port
        if (port == null) { return super.__hookPort(slot, op, k, v) }
        return port("" + this.__slot + "/" + slot, op, k, v)
    }

    // ── useState: estado propio que SOBREVIVE al re-render ───────────────────
    //
    // Un Component se re-instancia en cada frame, así que su estado no puede
    // vivir en sus campos. Vive en el DUEÑO (la Window raíz, que sí persiste) y
    // se llega a él por `__port`: un closure que el dueño creó DENTRO de su
    // propio render(), y que por eso captura su celda viva.
    //
    // Es el modelo de React: el componente no guarda su estado, lo guarda el
    // árbol. El índice `k` es el orden de llamada, así que —igual que en React—
    // los hooks no pueden ir adentro de un if ni de un bucle.
    //
    //   let par = this.useState(0)
    //   let n    = par[0]
    //   let subir = par[1]
    //   <Button onClick={() => { subir(n + 1) }}>{n}</Button>
    public any useState(any inicial) {
        let k = this.__hook
        this.__hook = k + 1
        let port = this.__port
        if (port == null) {
            // Sin dueño no hay dónde guardar: pasa si el componente se instancia
            // a mano en vez de por JSX. Se degrada a un valor fijo en vez de
            // romper, pero no persiste.
            return [inicial, (v) => {}]
        }
        let s = this.__slot
        let clave = "#" + k
        let valor = port(s, 0, clave, inicial)
        return [valor, (v) => { port(s, 1, clave, v) }]
    }

    // ── Estado con NOMBRE: state / setState ──────────────────────────────────
    //
    // La alternativa a useState cuando querés que el componente se lea como algo
    // autónomo, sin la ceremonia del par [valor, setter]:
    //
    //   class Contador:Component {
    //       render() {
    //           let n = this.state("n", 0)
    //           return (<Button onClick={() => { this.setState("n", n + 1) }}>{n}</Button>)
    //       }
    //   }
    //
    // La diferencia real con useState no es la sintaxis: la clave es el NOMBRE,
    // no el orden de llamada. Por eso esto SÍ se puede poner adentro de un `if`
    // o de un bucle, que es la regla que React tiene que prohibir.
    //
    // Funciona por lo mismo que useState —el valor vive en el store del dueño—
    // y desde un handler se llega por `this`: la instancia está muerta, pero el
    // puerto que guarda es un closure y un closure copiado conserva su celda.
    public any state(string nombre, any inicial) {
        let port = this.__port
        if (port == null) { return inicial }
        return port(this.__slot, 0, nombre, inicial)
    }

    public void setState(string nombre, any valor) {
        let port = this.__port
        if (port == null) { return; }
        port(this.__slot, 1, nombre, valor)
    }

    // ── useRef: una caja que persiste y NO es una foto ───────────────────────
    //
    // useState te da el VALOR del render actual; si lo leés dentro de un handler
    // que corre después, leés el de entonces. useRef devuelve [leer, escribir]:
    // `leer()` consulta el store en el momento en que se llama, así que un
    // handler siempre ve lo último.
    //
    //   let r = this.useRef(0)
    //   let leer = r[0]
    //   let poner = r[1]
    //   <Button onClick={() => { poner(leer() + 1) }}>…</Button>
    public any useRef(any inicial) {
        let k = this.__hook
        this.__hook = k + 1
        let port = this.__port
        if (port == null) { return [() => { return inicial }, (v) => {}] }
        let s = this.__slot
        let clave = "#" + k
        port(s, 0, clave, inicial)
        return [() => { return port(s, 0, clave, inicial) }, (v) => { port(s, 1, clave, v) }]
    }

    // ── useReducer: el mismo estado, con las transiciones en un solo lugar ───
    //
    //   fn any bajar(any estado, any accion) { … return nuevo }
    //   let r = this.useReducer(bajar, 0)
    //   let n = r[0]
    //   let enviar = r[1]
    //   <Button onClick={() => { enviar("mas") }}>{n}</Button>
    public any useReducer(any reducer, any inicial) {
        let par = this.useState(inicial)
        let estado = par[0]
        let poner = par[1]
        return [estado, (accion) => { poner(reducer(estado, accion)) }]
    }

    // ── useMemo: recalcular sólo cuando cambian los deps ─────────────────────
    //
    // Los deps van como ARRAY acá (a diferencia de useEffect): este hook corre
    // dentro del render, así que el array ya trae los valores de esta pasada.
    public any useMemo(any calcular, any deps) {
        let k = this.__hook
        this.__hook = k + 1
        let port = this.__port
        if (port == null) { return calcular() }
        let s = this.__slot
        let clave = "#" + k
        let guardado = port(s, 0, clave, null)
        if (guardado != null && __mismosDeps(guardado[0], deps)) { return guardado[1] }
        let valor = calcular()
        port(s, 1, clave, [deps, valor])
        return valor
    }

    // ── useCallback: la misma función mientras no cambien los deps ───────────
    public any useCallback(any f, any deps) {
        return this.useMemo(() => { return f }, deps)
    }

    // ── Context: un valor que baja sin pasar por props ───────────────────────
    //
    // La Window raíz lo publica con provide(nombre, valor); cualquier
    // componente del árbol lo lee con this.useContext(nombre). Evita el
    // prop-drilling sin necesitar un Provider en el árbol: el valor vive en el
    // mismo store, en una fila reservada.
    public any useContext(string nombre) {
        let port = this.__port
        if (port == null) { return null }
        return port("__ctx", 2, 0, nombre)
    }
}

// ¿Dos listas de deps son iguales? null en cualquiera fuerza el recálculo.
export fn bool __mismosDeps(any a, any b) {
    if (a == null || b == null) { return false }
    if (a.length() != b.length()) { return false }
    let i = 0
    while (i < a.length()) {
        if (a[i] != b[i]) { return false }
        i = i + 1
    }
    return true
}

// ── Helpers que emite el translator ───────────────────────────────────────────

// __makeProps([["k", v], ...]) → dict <string, any>
// Construye el dict de props desde pares. Evita escribir dict-literals en el
// código generado (su sintaxis es quisquillosa). Usa for (no while) por el
// gotcha de asignación a dict dentro de while.
export fn any __makeProps(any pairs) {
    let d <string, any> = ()
    for (let i = 0; i < pairs.length(); i = i + 1) {
        let pair = pairs[i]
        d[pair[0]] = pair[1]
    }
    return d
}

// ── Reenvío de class/id de componente → nodo raíz (helpers, antes del caller
//    porque en serez-code una fn debe estar definida antes de invocarse) ────────

// ¿el dict `props` tiene la clave `k`? (acceso directo a dict lanza en clave ausente).
export fn bool __propsHas(any props, string k) {
    let ks = props.keys()
    let i = 0
    while (i < ks.length()) {
        if (ks[i] == k) { return true }
        i = i + 1
    }
    return false
}

// ¿`tag` es un elemento pintable (no un fragment/texto interno)?
export fn bool __isElementTag(string tag) {
    return tag != "__fragment__" && tag != "__text__"
}

// Mergea dos listas de clases (separadas por espacio) sin duplicar tokens, para que
// un componente que reenvía la clase a mano Y el auto-forward no den `"card card"`.
export fn string __mergeClasses(string existing, string incoming) {
    let res = existing.trim()
    let seen = res.split(" ")
    let inc = incoming.trim().split(" ")
    let j = 0
    while (j < inc.length()) {
        let tok = inc[j].trim()
        if (tok.length() > 0) {
            let dup = false
            let k = 0
            while (k < seen.length()) {
                if (seen[k].trim() == tok) { dup = true }
                k = k + 1
            }
            if (!dup) {
                if (res.length() > 0) { res = res + " " + tok } else { res = tok }
                seen.push(tok)
            }
        }
        j = j + 1
    }
    return res
}

// Copia el atributo `name` de los props del componente al VNode raíz y DEVUELVE el
// tree (los objetos se pasan por VALOR en serez-code: hay que reasignar el retorno
// para conservar la mutación — el llamador hace `tree = __forwardAttr(tree, ...)`).
// merge=true → la clase entrante se APPENDEA a la existente (ambas aplican).
// merge=false → solo se copia si el raíz no tenía ninguno (el del render gana).
export fn any __forwardAttr(any tree, any props, string name, bool merge) {
    if (!__propsHas(props, name)) { return tree; }
    let incoming = ("" + props[name]).trim()
    if (incoming.length() == 0) { return tree; }
    let existing = tree.getProp(name)
    if (existing == null) {
        tree.setProp(name, incoming)
    } else {
        if (merge) {
            tree.setProp(name, __mergeClasses("" + existing, incoming))
        }
    }
    return tree
}

// __renderComponent(new MiComp(), props, children) → VNode
// Inyecta props/children en la instancia y devuelve su árbol renderizado.
// El resultado se inserta como un child más; el aplanado lo hace __h.
//
// Si el Component override styleVars() (variables .szs derivadas de props), las
// ESTAMPA en el VNode devuelto: la Window raíz las recolecta recorriendo el vdom
// (Window.__allStyleVars), de modo que el CSS reactivo también reacciona al estado
// que vive en los componentes, no solo en la Window raíz. Solo aplica a styleVars()
// derivadas de props (el estado interno del componente es efímero por frame).
// `base` y `port` los emite el traductor. Tienen default para que un call site
// viejo —de tres argumentos, escrito a mano en un harness— siga funcionando: el
// componente se renderiza igual, sólo que su useState no persiste.
export fn any __renderComponent(any comp, any props, any children, any base = 0, any port = null) {
    comp._init(props, children)
    // El puerto llega desde el call site: un closure creado adentro del render()
    // del dueño. Sin él, useState no persiste (ver Component.useState).
    //
    // `base` es la posición del tag en el archivo fuente: única por tag, estable
    // entre renders. Con `key` se le agrega la clave, así que un .map() le da a
    // cada fila su propio estado y lo conserva aunque la lista se reordene —
    // que es para lo que sirve `key` en React.
    let slot = base
    if (__propsHas(props, "key")) { slot = "" + base + "#" + props["key"] }
    comp.__port = port
    comp.__slot = slot
    comp.__hook = 0
    let tree = comp.render()
    let vars = comp.styleVars()
    if (vars.length() > 0) {
        // El árbol debe ser un VNode para poder estampar; si el componente devolvió
        // texto o un array crudo, lo envolvemos en un fragment (transparente al render).
        if (type_of(tree) != "VNode") { tree = __hFrag([tree]); }
        tree.setStyleVars(vars)
    }
    // Reenvía `class`/`id` de los props del componente al VNode raíz que produce,
    // para que `<MiComp class="x" id="y">` aplique `.x`/`#y` sobre su nodo raíz (como
    // React reenviando className/id — pero automático). Sin esto, la clase quedaba en
    // `this.props["class"]` y nunca llegaba a un nodo, así que `.x` no matcheaba.
    //   - class: se MERGEA (append) con la que el render ya haya puesto → aplican ambas.
    //   - id: se pone solo si el raíz no declaró uno (la identidad interna del render gana).
    // Un fragment no se pinta, así que no puede llevar la clase: se la pasa a su
    // ÚNICO hijo-elemento. Sin esto, envolver el render en `<></>` — algo que se
    // hace sin pensarlo — silenciaba `<MiComp class="x">` por completo: la clase
    // quedaba en this.props y no llegaba a ningún nodo, y `.x` no matcheaba nada.
    // Con más de un hijo no se reenvía: la clase es una sola y aplicarla a todos
    // los hermanos pintaría de más (React directamente no acepta class en un
    // fragment; acá al menos el caso de uno solo se resuelve).
    if (type_of(tree) == "VNode" && tree.getTag() == "__fragment__") {
        let kids = tree.getChildren()
        let elems = []
        let ki = 0
        while (ki < kids.length()) {
            if (type_of(kids[ki]) == "VNode" && __isElementTag(kids[ki].getTag())) {
                elems.push(ki)
            }
            ki = ki + 1
        }
        if (elems.length() == 1) {
            let idx = elems[0]
            let only = kids[idx]
            only = __forwardAttr(only, props, "class", true)
            only = __forwardAttr(only, props, "id", false)
            kids[idx] = only
            tree.setChildren(kids)
        }
    }

    // Solo a un nodo-elemento raíz (no fragment/texto: no se pintan como elemento).
    if (type_of(tree) == "VNode" && __isElementTag(tree.getTag())) {
        tree = __forwardAttr(tree, props, "class", true)
        tree = __forwardAttr(tree, props, "id", false)
    }
    return tree
}
