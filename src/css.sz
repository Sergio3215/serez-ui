// css.sz — CSS con lógica (.szs) para serez-ui (v0.6.0)
//
// Fiel a Propuesta.md: un CSS, pero con compuertas lógicas. Los selectores
// pueden llevar una condición que se evalúa contra el estado (reactivo):
//
//   :import {
//       count: count;
//   }
//
//   body (count == 0) { background-color: #0f172a; }
//   body (count != 0) { background-color: #14532d; }
//   h1               { color: #ffd166; }
//   Button           { background-color: #3b82f6; }
//
// El parser corre en serez-code puro (como translate.sz para .szx). El renderer
// llama `sheet.resolveProp(tag, prop, ctx)` cada frame; `ctx` es un array
// [[nombre, valor]] con el estado actual → condiciones reactivas.
//
// NOTAS de implementación (límites de serez-code):
//  - El .szs se lee de un ARCHIVO (File.read), no de string literal (serez-code
//    interpola {} dentro de los string literals → usar archivos).
//  - En módulos importados una función sólo ve a las definidas ANTES → helpers
//    primero, parseCss al final.
//  - Para escribir `{` literal en un string se usa "\{".
//  - El stylesheet se guarda como ARRAYS PLANOS PARALELOS (sin arrays anidados
//    profundos), porque arrays-de-arrays en cierto nivel se corrompen.

// ── Helpers leaf ───────────────────────────────────────────────────────────────

// Propiedades que ALGÚN renderer honra de verdad (interpretado o nativo).
//
// No es "el CSS que existe": es lo que este motor mira. Todo lo demás se parsea
// igual — el parser es genérico — y se ignora en silencio, que es justamente lo
// que `Stylesheet.unknownProps()` sirve para descubrir.
//
// Si agregás soporte para una propiedad nueva en un renderer, SUMALA acá, o el
// chequeo te la va a reportar como desconocida.
export fn any szsKnownProps() {
    return [
        // caja y layout
        "display", "flex", "flex-direction", "justify-content", "align-items",
        "gap", "row-gap", "width", "height", "min-width", "max-width",
        "padding", "padding-top", "padding-right", "padding-bottom", "padding-left",
        "margin", "margin-top", "margin-right", "margin-bottom", "margin-left",
        "position", "top", "right", "bottom", "left", "overflow", "z-index",
        "grid-template-columns", "grid-template-rows",
        // color y fondo
        "color", "background", "background-color", "background-image", "opacity",
        // borde
        "border", "border-color", "border-width", "border-radius", "box-shadow",
        // tipografía
        "font-family", "font-size", "font-scale", "font-weight", "font-style",
        "line-height", "letter-spacing", "text-align", "text-decoration",
        "text-transform", "white-space", "direction",
        // otros
        "transform", "cursor"
    ]
}

// Pseudo-clases que los renderers saben evaluar. Son ESTADOS de interacción y
// nada más: ninguno de los dos motores tiene noción de posición entre hermanos,
// así que `:first-child`, `:last-child`, `:nth-child(…)` y compañía se parsean
// igual y no matchean nunca. `Stylesheet.unknownSelectors()` los delata.
// Pseudo-clases que el renderer resuelve. Las cuatro de interacción vienen del
// estado del widget; las de POSICIÓN se resuelven contra el sitio que estampa
// stampAnc (posición entre hermanos y total), disponible desde 4.35.
export fn any szsKnownPseudos() {
    return ["first-child", "last-child", "only-child", "nth-child", "hover", "focus", "active", "disabled", "active-focus"]
}

export fn bool cssIsWs(string c) {
    return c == " " || c == "\t" || c == "\n" || c == "\r"
}

export fn bool cssIsNameChar(string c) {
    return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-*".includes(c)
}

export fn int cssHexDigit(string c) {
    let lower = "0123456789abcdef"
    let i = 0
    while (i < 16) {
        if (lower.charAt(i) == c) { return i; }
        i = i + 1
    }
    let upper = "ABCDEF"
    i = 0
    while (i < 6) {
        if (upper.charAt(i) == c) { return 10 + i; }
        i = i + 1
    }
    return -1
}

export fn int cssIndexOf(string hay, string needle) {
    let n = hay.length()
    let m = needle.length()
    if (m == 0) { return -1; }
    let i = 0
    while (i + m <= n) {
        if (hay.substring(i, i + m) == needle) { return i; }
        i = i + 1
    }
    return -1
}

export fn bool cssIsNum(string s) {
    let t = s.trim()
    if (t.length() == 0) { return false; }
    let i = 0
    if (t.charAt(0) == "-") { i = 1; }
    if (i >= t.length()) { return false; }
    while (i < t.length()) {
        if (!"0123456789".includes(t.charAt(i))) { return false; }
        i = i + 1
    }
    return true
}

export fn int cssToNum(string s) {
    return parseInt(s.trim())
}

export fn string cssStripQuotes(string s) {
    let t = s.trim()
    if (t.length() >= 2) {
        let a = t.charAt(0)
        let b = t.charAt(t.length() - 1)
        if ((a == "'" && b == "'") || (a == "\"" && b == "\"")) {
            return t.substring(1, t.length() - 1)
        }
    }
    return t
}

// Busca un nombre en ctx = [[nombre, valor], ...]  (array de pares, nivel 2).
export fn any cssLookup(any ctx, string name) {
    if (ctx == null) { return null; }
    let i = 0
    while (i < ctx.length()) {
        let pair = ctx[i]
        if (pair[0] == name) { return pair[1]; }
        i = i + 1
    }
    return null
}

// Evalúa "var OP literal" contra el ctx. true si pasa (o no aplica).
export fn bool cssCondEval(string cvar, string op, string valStr, any ctx) {
    let lv = cssLookup(ctx, cvar)
    if (lv == null) { return false; }

    // Condición sin operador: `body (flag) { … }` — truthy del valor del ctx
    // ("false", "0", "" y "null" son falsos; cualquier otro valor pasa).
    // Espejo de css_cond_eval del core (css.rs).
    if (op == "") {
        let t = ("" + lv).trim()
        return !(t == "" || t == "false" || t == "0" || t == "null")
    }

    let bothNum = (lv is int || lv is decimal) && cssIsNum(valStr)
    if (bothNum) {
        let r = cssToNum(valStr)
        if (op == "==") { return lv == r; }
        if (op == "!=") { return lv != r; }
        if (op == "<")  { return lv < r; }
        if (op == ">")  { return lv > r; }
        if (op == "<=") { return lv <= r; }
        if (op == ">=") { return lv >= r; }
        return false
    }

    let r = cssStripQuotes(valStr)
    let l = "" + lv
    if (op == "==") { return l == r; }
    if (op == "!=") { return l != r; }
    return false
}

// Convierte un color CSS (#rgb, #rrggbb o nombre) a int 0xRRGGBB, o -1 si inválido.
// Componente 0-255 de un rgb()/rgba(): entero (un decimal se trunca); -1 si inválido.
export fn int cssColorComp(string p) {
    let t = p.trim()
    let dot = cssIndexOf(t, ".")
    if (dot >= 0) { t = t.substring(0, dot) }
    if (t.length() == 0) { return -1; }
    let val = 0
    let i = 0
    while (i < t.length()) {
        let ch = t.charAt(i)
        let d = -1
        if (ch == "0") { d = 0 } else { if (ch == "1") { d = 1 } else { if (ch == "2") { d = 2 }
        else { if (ch == "3") { d = 3 } else { if (ch == "4") { d = 4 } else { if (ch == "5") { d = 5 }
        else { if (ch == "6") { d = 6 } else { if (ch == "7") { d = 7 } else { if (ch == "8") { d = 8 }
        else { if (ch == "9") { d = 9 } } } } } } } } } }
        if (d < 0) { return -1; }
        val = val * 10 + d
        i = i + 1
    }
    if (val > 255) { val = 255 }
    return val
}

export fn int cssColor(string raw) {
    let s = raw.trim()
    if (s.length() == 0) { return -1; }
    if (s.charAt(0) == "#") {
        let hex = s.substring(1, s.length())
        // #rgba / #rrggbbaa (lo emiten los color-pickers): el canal alpha se
        // DESCARTA acá — la translucidez del interpretado va por `opacity`; en
        // el motor nativo el alpha del FONDO sí se honra (prim_bg_alpha).
        if (hex.length() == 4) { hex = hex.substring(0, 3) }
        if (hex.length() == 8) { hex = hex.substring(0, 6) }
        if (hex.length() == 3) {
            let r = "" + hex.charAt(0) + hex.charAt(0)
            let g = "" + hex.charAt(1) + hex.charAt(1)
            let b = "" + hex.charAt(2) + hex.charAt(2)
            hex = r + g + b
        }
        if (hex.length() != 6) { return -1; }
        let val = 0
        let i = 0
        while (i < 6) {
            let d = cssHexDigit(hex.charAt(i))
            if (d < 0) { return -1; }
            val = val * 16 + d
            i = i + 1
        }
        return val
    }
    // rgb(r, g, b) / rgba(r, g, b, a) — mismo soporte que el motor nativo (el
    // alpha del color se ignora; translucidez = `opacity`).
    let isRgba = s.length() > 5 && s.substring(0, 5) == "rgba("
    let isRgb  = !isRgba && s.length() > 4 && s.substring(0, 4) == "rgb("
    if (isRgb || isRgba) {
        let open = 4
        if (isRgba) { open = 5 }
        let close = cssIndexOf(s, ")")
        if (close < 0) { close = s.length() }
        let parts = s.substring(open, close).split(",")
        if (parts.length() < 3) { return -1; }
        let r = cssColorComp(parts[0])
        let g = cssColorComp(parts[1])
        let b = cssColorComp(parts[2])
        if (r < 0 || g < 0 || b < 0) { return -1; }
        return r * 65536 + g * 256 + b
    }
    if (s == "white")            { return 0xffffff; }
    if (s == "black")            { return 0x000000; }
    if (s == "red")              { return 0xff0000; }
    if (s == "green")            { return 0x008000; }
    if (s == "blue")             { return 0x0000ff; }
    if (s == "yellow")           { return 0xffff00; }
    if (s == "gray" || s == "grey") { return 0x808080; }
    return -1
}

// ── Helpers de scanning ───────────────────────────────────────────────────────

export fn any cssReadName(string src, int i) {
    let n = src.length()
    let name = ""
    while (i < n && cssIsNameChar(src.charAt(i))) { name = name + src.charAt(i); i = i + 1; }
    return [name, i]
}

// Salta espacios en blanco y comentarios (/* */ y //).
export fn int cssSkip(string src, int i) {
    let n = src.length()
    let go = true
    while (go) {
        go = false
        while (i < n && cssIsWs(src.charAt(i))) { i = i + 1; go = true; }
        if (i + 1 < n && src.charAt(i) == "/" && src.charAt(i + 1) == "*") {
            i = i + 2
            while (i + 1 < n && !(src.charAt(i) == "*" && src.charAt(i + 1) == "/")) { i = i + 1; }
            i = i + 2
            go = true
        }
        if (i + 1 < n && src.charAt(i) == "/" && src.charAt(i + 1) == "/") {
            i = i + 2
            while (i < n && src.charAt(i) != "\n") { i = i + 1; }
            go = true
        }
    }
    return i
}

// Lee declaraciones `prop: valor;` hasta '}'. i apunta tras '{'.
// Retorna [props, vals, nuevo_i] con dos arrays PLANOS paralelos de strings.
export fn any cssReadDecls(string src, int i) {
    let n = src.length()
    let props = []
    let vals  = []
    while (i < n && src.charAt(i) != "}") {
        i = cssSkip(src, i)
        if (i >= n || src.charAt(i) == "}") { break; }

        let prop = ""
        while (i < n && src.charAt(i) != ":" && src.charAt(i) != "}" && src.charAt(i) != ";") {
            prop = prop + src.charAt(i)
            i = i + 1
        }
        if (i < n && src.charAt(i) == ":") {
            i = i + 1
            let val = ""
            while (i < n && src.charAt(i) != ";" && src.charAt(i) != "}") {
                val = val + src.charAt(i)
                i = i + 1
            }
            if (i < n && src.charAt(i) == ";") { i = i + 1; }
            let pn = prop.trim()
            if (pn.length() > 0) { props.push(pn); vals.push(val.trim()); }
        } else {
            if (i < n && src.charAt(i) == ";") { i = i + 1; } else { break; }
        }
    }
    if (i < n && src.charAt(i) == "}") { i = i + 1; }
    return [props, vals, i]
}

// Parsea "var OP literal" → [var, op, literal]
export fn any cssParseCond(string s) {
    let ops2 = ["==", "!=", "<=", ">="]
    let k = 0
    while (k < ops2.length()) {
        let idx = cssIndexOf(s, ops2[k])
        if (idx >= 0) {
            let left  = s.substring(0, idx).trim()
            let right = s.substring(idx + 2, s.length()).trim()
            return [left, ops2[k], right]
        }
        k = k + 1
    }
    let ops1 = ["<", ">"]
    k = 0
    while (k < ops1.length()) {
        let idx = cssIndexOf(s, ops1[k])
        if (idx >= 0) {
            let left  = s.substring(0, idx).trim()
            let right = s.substring(idx + 1, s.length()).trim()
            return [left, ops1[k], right]
        }
        k = k + 1
    }
    return [s.trim(), "", ""]
}

// ── Condiciones compuestas: `and` / `or` / `not` ──────────────────────────────
//
// Gramática de la condición de una regla (lo que va entre paréntesis):
//
//   cond   := clause (CONN clause)*
//   CONN   := "and" | "&&" | "or" | "||"
//   clause := ["not" | "!"] var [op valor]
//
// Precedencia habitual: `not` liga más que `and`, y `and` más que `or`; o sea
// `a or b and c` es `a or (b and c)`. NO hay paréntesis de agrupación: el
// scanner de la hoja corta la condición en el primer `)`.
//
//   body (width > 600 and flag == true) { … }
//   .a   (flag == true or modo == "x")  { … }
//   .b   (not oculto)                   { … }

// Quita los `not`/`!` iniciales; devuelve [restoDelTexto, negado].
export fn any cssStripNot(string seg) {
    let s = seg.trim()
    let neg = false
    let sigue = true
    while (sigue) {
        sigue = false
        if (s.length() > 0 && s.charAt(0) == "!") {
            // `!=` es el operador de comparación, no una negación.
            if (!(s.length() > 1 && s.charAt(1) == "=")) {
                neg = !neg
                s = s.substring(1, s.length()).trim()
                sigue = true
            }
        } else {
            if (s.length() >= 3 && s.substring(0, 3).toLowerCase() == "not") {
                let resto = s.substring(3, s.length())
                // `not` sólo cuenta como palabra completa (`notify` es un nombre).
                if (resto.length() == 0 || !cssIsNameChar(resto.charAt(0))) {
                    neg = !neg
                    s = resto.trim()
                    sigue = true
                }
            }
        }
    }
    return [s, neg]
}

// Parte la condición en cláusulas por los conectores de tope. Devuelve
// [vars, ops, vals, negs, ors] (arrays paralelos, uno por cláusula); `ors[k]`
// es el conector que precede a la cláusula k (el de la primera se ignora).
// Las comillas se respetan, así que un valor "and" no parte nada.
export fn any cssParseCondList(string src) {
    let vars = []
    let ops  = []
    let vals = []
    let negs = []
    let ors  = []
    let n = src.length()
    let start = 0
    let i = 0
    let quote = ""
    let orConn = false
    while (i < n) {
        let c = src.charAt(i)
        if (quote != "") {
            if (c == quote) { quote = "" }
            i = i + 1
            continue
        }
        if (c == "'" || c == "\"") { quote = c; i = i + 1; continue }
        let dobleAnd = c == "&" && i + 1 < n && src.charAt(i + 1) == "&"
        let dobleOr  = c == "|" && i + 1 < n && src.charAt(i + 1) == "|"
        if (dobleAnd || dobleOr) {
            let seg = src.substring(start, i)
            if (seg.trim().length() > 0) {
                let cl = cssPushClause(seg, orConn)
                vars.push(cl[0]); ops.push(cl[1]); vals.push(cl[2]); negs.push(cl[3]); ors.push(cl[4])
            }
            orConn = dobleOr
            i = i + 2
            start = i
            continue
        }
        if (cssIsNameChar(c)) {
            // Sólo el comienzo de una palabra puede ser un conector.
            if (i > 0 && cssIsNameChar(src.charAt(i - 1))) { i = i + 1; continue }
            let j = i
            while (j < n && cssIsNameChar(src.charAt(j))) { j = j + 1 }
            let w = src.substring(i, j).toLowerCase()
            if (w == "and" || w == "or") {
                let seg = src.substring(start, i)
                if (seg.trim().length() > 0) {
                    let cl = cssPushClause(seg, orConn)
                    vars.push(cl[0]); ops.push(cl[1]); vals.push(cl[2]); negs.push(cl[3]); ors.push(cl[4])
                }
                orConn = w == "or"
                start = j
            }
            i = j
            continue
        }
        i = i + 1
    }
    let seg = src.substring(start, n)
    if (seg.trim().length() > 0) {
        let cl = cssPushClause(seg, orConn)
        vars.push(cl[0]); ops.push(cl[1]); vals.push(cl[2]); negs.push(cl[3]); ors.push(cl[4])
    }
    return [vars, ops, vals, negs, ors]
}

// Una cláusula ya aislada → [var, op, val, negado, orConn].
export fn any cssPushClause(string seg, bool orConn) {
    let sn = cssStripNot(seg)
    let p  = cssParseCond(sn[0])
    return [p[0], p[1], p[2], sn[1], orConn]
}

// Evalúa la condición completa: OR de grupos AND, con `not` ya por cláusula.
export fn bool cssCondEvalAll(any vars, any ops, any vals, any negs, any ors, any ctx) {
    let done  = false   // acumulado de los grupos AND ya cerrados
    let group = true    // grupo AND en curso
    let k = 0
    while (k < vars.length()) {
        let v = cssCondEval(vars[k], ops[k], vals[k], ctx)
        if (negs[k]) { v = !v }
        if (k == 0) {
            group = v
        } else {
            if (ors[k]) {
                done = done || group   // `or` cierra el grupo AND anterior
                group = v
            } else {
                group = group && v
            }
        }
        k = k + 1
    }
    return done || group
}

// Evalúa la condición de una regla: AND de TÉRMINOS, cada uno negable. Todos deben
// pasar. Cada término es [neg, vars, ops, vals, negs, ors]: los aportan la condición
// propia de la regla y los bloques @when/@else que la envuelven (esos suman las
// negaciones de las ramas previas). Negar el RESULTADO del término —y no cada
// cláusula— evita aplicar De Morgan a condiciones compuestas. Lista vacía pasa.
export fn bool cssTermsEvalAll(any terms, any ctx) {
    let t = 0
    while (t < terms.length()) {
        let term = terms[t]
        let v = cssCondEvalAll(term[1], term[2], term[3], term[4], term[5], ctx)
        if (term[0]) { v = !v }
        if (!v) { return false }
        t = t + 1
    }
    return true
}

// ── Stylesheet (arrays planos paralelos) ───────────────────────────────────────

export public class Stylesheet {
    // Reglas (paralelas por índice ri):
    //   selectors[ri], hasConds[ri], condTerms[ri]
    // condTerms[ri] es la condición de la regla como AND de TÉRMINOS. Cada término
    // es [neg, vars, ops, vals, negs, ors]: una condición completa (OR-de-ANDs, los
    // cinco arrays paralelos por cláusula — `flag == true and w > 600` deja dos) más
    // un flag `neg` que niega su RESULTADO entero. Una regla suelta `sel (c) {}` tiene
    // un único término sin negar; los bloques `@when`/`@else` apilan términos: `@when
    // (C)` suma C y un `@else` posterior suma ¬C (más su propia condición).
    // Declaraciones (paralelas por índice di), enlazadas a su regla:
    //   declRuleIdx[di], declProps[di], declVals[di]
    public Stylesheet(any selectors, any hasConds, any condTerms, any declRuleIdx, any declProps, any declVals, any fontAliases, any fontPaths) {
        this.selectors   = selectors
        this.hasConds    = hasConds
        this.condTerms   = condTerms
        this.declRuleIdx = declRuleIdx
        this.declProps   = declProps
        this.declVals    = declVals
        // Fuentes declaradas en bloques `:font { alias: ruta.ttf; }` (paralelos).
        this.fontAliases = fontAliases
        this.fontPaths   = fontPaths
        // Texto `.szs` crudo (lo setea parseCss). Lo usa el camino de render NATIVO
        // para alimentar Gui.loadStylesheet del core (Fase 3), cuyo parser es un port
        // fiel de este. "" si se construyó sin parseCss.
        this.raw = ""

        // Precompute: rango [start,end) de declaraciones por selector. Las decls se
        // agregan agrupadas por regla al parsear, así que cada regla ocupa un rango
        // contiguo en los arrays paralelos. Acota el loop interno de resolveProp a las
        // ~pocas decls de la regla en vez de TODAS (era el cuello del render).
        this.declStart = []
        this.declEnd   = []
        let ns = selectors.length()
        let si = 0
        while (si < ns) { this.declStart.push(-1); this.declEnd.push(0); si = si + 1 }
        let di = 0
        while (di < declRuleIdx.length()) {
            let r = declRuleIdx[di]
            if (this.declStart[r] == -1) { this.declStart[r] = di }
            this.declEnd[r] = di + 1
            di = di + 1
        }
    }

    // Texto `.szs` crudo (para el camino de render nativo → Gui.loadStylesheet).
    public string rawSource()      { return this.raw }
    public void setRaw(string s)   { this.raw = s }

    // Propiedades DECLARADAS en la hoja que ningún renderer va a mirar.
    //
    // El parser es a propósito genérico: guarda cualquier `nombre: valor`, así
    // que `float: left`, `animation: spin 2s` o un typo como `colour: red`
    // entran sin chistar y después no hacen nada. Eso es lo que convierte un
    // error de tipeo en media hora mirando la pantalla. Esta lista lo delata.
    //
    // Devuelve los nombres (sin repetir) fuera del set soportado.
    public any unknownProps() {
        let known = szsKnownProps()
        let ajenas = []
        let i = 0
        while (i < this.declProps.length()) {
            let p = "" + this.declProps[i]
            let esConocida = false
            let k = 0
            while (k < known.length()) {
                if (known[k] == p) { esConocida = true }
                k = k + 1
            }
            if (!esConocida) {
                let yaEsta = false
                let j = 0
                while (j < ajenas.length()) {
                    if (ajenas[j] == p) { yaEsta = true }
                    j = j + 1
                }
                if (!yaEsta) { ajenas.push(p) }
            }
            i = i + 1
        }
        return ajenas
    }

    // Selectores DESCENDIENTES (`Row Button`, `.card p`), que sólo aplican con
    // el renderer nativo.
    //
    // El core los matchea de verdad — recorre la cadena de ancestros y hasta
    // degrada `>` a descendiente — pero el renderer INTERPRETADO, que es el modo
    // por defecto, resuelve por tag/clase/id sueltos y no lleva ancestros. O sea
    // que la misma hoja pinta distinto según el modo, y en el default la regla
    // no hace nada sin decir una palabra.
    // Selectores de UN término pero COMPUESTO (`p.a`, `.a.b`, `#main.activo`).
    // Sin espacio, así que no son descendientes; y el lookup por string exacto
    // no los encuentra porque prueba tag, `.clase` y `#id` por separado.
    // Se excluyen los que llevan pseudo-estado (`:hover`), que tienen su propio
    // camino, y los que llevan pseudo-clase no soportada, que ya se avisan.
    // Selectores de ATRIBUTO (`p[x=1]`): no se soportan y nunca matchean. Van al
    // mismo aviso que las propiedades y las pseudo-clases, para que no fallen
    // en silencio — que era el problema real, no la falta de la feature.
    public any attributeSelectors() {
        let res = []
        let i = 0
        while (i < this.selectors.length()) {
            let sel = ("" + this.selectors[i]).trim()
            if (cssIndexOf(sel, "[") >= 0) {
                let ya = false
                let j = 0
                while (j < res.length()) { if (res[j] == sel) { ya = true } j = j + 1 }
                if (!ya) { res.push(sel) }
            }
            i = i + 1
        }
        return res
    }

    public any compoundSelectors() {
        let res = []
        let i = 0
        while (i < this.selectors.length()) {
            let sel = ("" + this.selectors[i]).trim()
            // Compuesto = más de UNA pieza. Se cuentan los separadores y se
            // suma una pieza inicial si el selector arranca con un tag.
            //   ".a"   → 1 pieza  (no compuesto)
            //   ".a.b" → 2        (compuesto; el primer '.' está en 0, por eso
            //                      no alcanza con mirar la posición)
            //   "p.a"  → 2
            let seps = 0
            let ci = 0
            while (ci < sel.length()) {
                let ch = sel.charAt(ci)
                if (ch == "." || ch == "#") { seps = seps + 1 }
                ci = ci + 1
            }
            let piezas = seps
            if (sel.length() > 0 && sel.charAt(0) != "." && sel.charAt(0) != "#") { piezas = piezas + 1 }
            if (cssIndexOf(sel, " ") < 0 && cssIndexOf(sel, ":") < 0 && piezas > 1) {
                let ya = false
                let j = 0
                while (j < res.length()) { if (res[j] == sel) { ya = true } j = j + 1 }
                if (!ya) { res.push(sel) }
            }
            i = i + 1
        }
        return res
    }

    // Selectores con combinador de HERMANO (`h1 + p`, `h1 ~ p`).
    public any siblingSelectors() {
        let res = []
        let i = 0
        while (i < this.selectors.length()) {
            let sel = ("" + this.selectors[i]).trim()
            if (cssIndexOf(sel, "+") >= 0 || cssIndexOf(sel, "~") >= 0) {
                let ya = false
                let j = 0
                while (j < res.length()) { if (res[j] == sel) { ya = true } j = j + 1 }
                if (!ya) { res.push(sel) }
            }
            i = i + 1
        }
        return res
    }

    // Selectores con pseudo-clase de POSICIÓN (:first-child, :nth-child(n)…),
    // que ahora sí se resuelven contra el sitio estampado en el nodo.
    public any positionSelectors() {
        let res = []
        let i = 0
        while (i < this.selectors.length()) {
            let sel = ("" + this.selectors[i]).trim()
            let esPos = cssIndexOf(sel, ":first-child") >= 0 || cssIndexOf(sel, ":last-child") >= 0
                     || cssIndexOf(sel, ":only-child") >= 0 || cssIndexOf(sel, ":nth-child(") >= 0
            if (esPos && cssIndexOf(sel, " ") < 0 && cssIndexOf(sel, "+") < 0 && cssIndexOf(sel, "~") < 0) {
                let ya = false
                let j = 0
                while (j < res.length()) { if (res[j] == sel) { ya = true } j = j + 1 }
                if (!ya) { res.push(sel) }
            }
            i = i + 1
        }
        return res
    }

    public any descendantSelectors() {
        let ajenos = []
        let i = 0
        while (i < this.selectors.length()) {
            let sel = ("" + this.selectors[i]).trim()
            if (cssIndexOf(sel, " ") >= 0) {
                let yaEsta = false
                let j = 0
                while (j < ajenos.length()) {
                    if (ajenos[j] == sel) { yaEsta = true }
                    j = j + 1
                }
                if (!yaEsta) { ajenos.push(sel) }
            }
            i = i + 1
        }
        return ajenos
    }

    // Selectores con una pseudo-clase que ningún renderer sabe evaluar.
    //
    // Mismo silencio que unknownProps() pero en el otro eje: `Button:first-child`
    // se parsea y se guarda perfecto, y después no matchea nunca porque los
    // motores sólo manejan estados de interacción. Sin esto, la regla existe,
    // no da error y no pinta nada.
    public any unknownSelectors() {
        let conocidas = szsKnownPseudos()
        let ajenos = []
        let i = 0
        while (i < this.selectors.length()) {
            let sel = "" + this.selectors[i]
            let col = cssIndexOf(sel, ":")
            if (col >= 0) {
                let pseudo = sel.substring(col + 1, sel.length())
                // `nth-child(2)` se compara por el nombre, sin el argumento.
                let par = cssIndexOf(pseudo, "(")
                if (par >= 0) { pseudo = pseudo.substring(0, par) }
                let esConocida = false
                let k = 0
                while (k < conocidas.length()) {
                    if (conocidas[k] == pseudo) { esConocida = true }
                    k = k + 1
                }
                if (!esConocida) {
                    let yaEsta = false
                    let j = 0
                    while (j < ajenos.length()) {
                        if (ajenos[j] == sel) { yaEsta = true }
                        j = j + 1
                    }
                    if (!yaEsta) { ajenos.push(sel) }
                }
            }
            i = i + 1
        }
        return ajenos
    }

    // Fuentes declaradas con :font — el renderer las carga perezosamente.
    public int fontCount()        { return this.fontAliases.length() }
    public string fontAlias(int i) { return this.fontAliases[i] }
    public string fontPath(int i)  { return this.fontPaths[i] }

    // ¿Hay alguna regla con EXACTAMENTE este selector? (p.ej. "Button:focus").
    // Lo usa el renderer para saber si el app OPTÓ por marcar el foco.
    public bool hasSelector(string sel) {
        let i = 0
        while (i < this.selectors.length()) {
            if (this.selectors[i] == sel) { return true }
            i = i + 1
        }
        return false
    }

    // Valor (string) de una prop para un tag dado el ctx, o null. Última gana.
    public any resolveProp(string tag, string prop, any ctx) {
        let found = null
        let ri = 0
        while (ri < this.selectors.length()) {
            let sel = this.selectors[ri]
            if (sel == tag || sel == "*") {
                let pass = true
                if (this.hasConds[ri]) {
                    pass = cssTermsEvalAll(this.condTerms[ri], ctx)
                }
                if (pass) {
                    let ds = this.declStart[ri]
                    if (ds >= 0) {
                        let de = this.declEnd[ri]
                        let di = ds
                        while (di < de) {
                            if (this.declRuleIdx[di] == ri && this.declProps[di] == prop) {
                                found = this.declVals[di]
                            }
                            di = di + 1
                        }
                    }
                }
            }
            ri = ri + 1
        }
        return found
    }

    // Conveniencia: color (int 0xRRGGBB) de una prop, o `fallback`.
    public int colorProp(string tag, string prop, int fallback, any ctx) {
        let v = this.resolveProp(tag, prop, ctx)
        if (v == null) { return fallback; }
        let c = cssColor(v)
        if (c < 0) { return fallback; }
        return c
    }

    // Resuelve TODAS las props aplicables a `tag` en UN solo escaneo (última gana),
    // devolviendo [props[], vals[]]. El renderer cachea esto por tag y por frame, así
    // hace ~1 escaneo por tag en vez de uno por (tag,prop) (el cuello del render).
    public any allPropsForTag(string tag, any ctx) {
        let props = []
        let vals  = []
        let ri = 0
        while (ri < this.selectors.length()) {
            let sel = this.selectors[ri]
            if (sel == tag || sel == "*") {
                let pass = true
                if (this.hasConds[ri]) {
                    pass = cssTermsEvalAll(this.condTerms[ri], ctx)
                }
                if (pass) {
                    let ds = this.declStart[ri]
                    if (ds >= 0) {
                        let de = this.declEnd[ri]
                        let di = ds
                        while (di < de) {
                            if (this.declRuleIdx[di] == ri) {
                                let p = this.declProps[di]
                                let fi = -1
                                let k = 0
                                while (k < props.length()) {
                                    if (props[k] == p) { fi = k; k = props.length() } else { k = k + 1 }
                                }
                                if (fi >= 0) { vals[fi] = this.declVals[di] }
                                else { props.push(p); vals.push(this.declVals[di]) }
                            }
                            di = di + 1
                        }
                    }
                }
            }
            ri = ri + 1
        }
        return [props, vals]
    }

    // Convierte un valor crudo (string|null) a color int, o `fallback`.
    public int rawToColor(any v, int fallback) {
        if (v == null) { return fallback; }
        let c = cssColor(("" + v).trim())
        if (c < 0) { return fallback; }
        return c
    }
}

// ── Parser (al final: usa todos los helpers de arriba) ─────────────────────────

// Copia superficial de un array de términos (los términos no se mutan in situ, solo
// se apilan enteros). Evita depender de la semántica de asignación de arrays de .sz.
export fn any cssCopyTerms(any terms) {
    let acc = []
    let k = 0
    while (k < terms.length()) { acc.push(terms[k]); k = k + 1 }
    return acc
}

// Salta una at-rule desconocida (`@media`, …): su bloque {...} balanceado desde `i`,
// o hasta el primer `;` si no abre bloque. Devuelve el índice tras el cierre.
export fn int cssSkipAtRule(string src, int i) {
    let n = src.length()
    while (i < n && src.charAt(i) != "\{" && src.charAt(i) != ";") { i = i + 1 }
    if (i < n && src.charAt(i) == ";") { return i + 1 }
    if (i < n && src.charAt(i) == "\{") {
        let depth = 0
        while (i < n) {
            let c = src.charAt(i)
            if (c == "\{") { depth = depth + 1 }
            else { if (c == "}") { depth = depth - 1; if (depth == 0) { return i + 1 } } }
            i = i + 1
        }
    }
    return i
}

export fn any parseCss(string src) {
    let n = src.length()
    let i = 0

    let selectors   = []
    let hasConds    = []
    let condTerms   = []   // por regla: array de términos [neg,vars,ops,vals,negs,ors]
    let declRuleIdx = []
    let declProps   = []
    let declVals    = []
    let fontAliases = []
    let fontPaths   = []

    // Pila de bloques @when/@else. `curAmbient` son los términos activos para las
    // reglas del nivel actual; `elseNeg` las negaciones que un @else de este nivel
    // debe AND-ear (las reinicia cualquier statement que no sea @else). Al abrir un
    // bloque se apila [ambientDelPadre, elseNegDelPadre] y se restaura en su `}`.
    let curAmbient = []
    let elseNeg    = []
    let stack      = []

    while (i < n) {
        i = cssSkip(src, i)
        if (i >= n) { break; }
        let c = src.charAt(i)

        // Cierre de un bloque @when/@else: restaura el estado del nivel padre.
        if (c == "}") {
            if (stack.length() > 0) {
                let fr = stack.pop()
                curAmbient = fr[0]
                elseNeg    = fr[1]
            }
            i = i + 1
            continue
        }

        // Bloques @when (cond) { ... } / @else [(cond)] { ... }.
        if (c == "@") {
            let akw = cssReadName(src, i + 1)
            let aname = akw[0].toLowerCase()
            if (aname == "when" || aname == "else") {
                i = parseInt(akw[1])
                i = cssSkip(src, i)
                // Condición del bloque: obligatoria en @when, opcional en @else.
                let hasT = false
                let tvar = []; let top = []; let tval = []; let tneg = []; let tor = []
                if (i < n && src.charAt(i) == "(") {
                    i = i + 1
                    let cs = ""
                    while (i < n && src.charAt(i) != ")") { cs = cs + src.charAt(i); i = i + 1; }
                    if (i < n) { i = i + 1; }
                    let pc = cssParseCondList(cs)
                    tvar = pc[0]; top = pc[1]; tval = pc[2]; tneg = pc[3]; tor = pc[4]
                    hasT = tvar.length() > 0
                }
                // Ambiente del cuerpo = heredado (+ negaciones previas si es @else) (+ propio).
                let branch = cssCopyTerms(curAmbient)
                if (aname == "else") {
                    let e = 0
                    while (e < elseNeg.length()) { branch.push(elseNeg[e]); e = e + 1 }
                }
                if (hasT) { branch.push([false, tvar, top, tval, tneg, tor]) }
                // elseNeg que verá el @else siguiente de ESTE nivel: @when abre cadena
                // nueva; el término negado alimenta al @else; @else pelado la cierra.
                let newElse = []
                if (aname == "else") {
                    let e2 = 0
                    while (e2 < elseNeg.length()) { newElse.push(elseNeg[e2]); e2 = e2 + 1 }
                }
                if (hasT) { newElse.push([true, tvar, top, tval, tneg, tor]) }
                else { newElse = [] }
                i = cssSkip(src, i)
                if (i < n && src.charAt(i) == "\{") {
                    stack.push([cssCopyTerms(curAmbient), newElse])
                    curAmbient = branch
                    elseNeg = []
                    i = i + 1
                }
                continue
            }
            // At-rule desconocida (@media, …): se descarta entera y corta la cadena.
            elseNeg = []
            i = cssSkipAtRule(src, i)
            continue
        }

        // Cualquier otro statement (:bloque o regla) corta la cadena if/else.
        elseNeg = []

        // Bloques :import { ... } (se salta; los valores los da el ctx) y
        // :font { alias: ruta.ttf; } (declara fuentes que el renderer carga).
        if (c == ":") {
            let kw = cssReadName(src, i + 1)
            if (kw[0] == "import" || kw[0] == "font") {
                let isFont = kw[0] == "font"
                i = parseInt(kw[1])
                i = cssSkip(src, i)
                if (i < n && src.charAt(i) == "\{") {
                    let res = cssReadDecls(src, i + 1)
                    if (isFont) {
                        let fprops = res[0]
                        let fvals  = res[1]
                        let fk = 0
                        while (fk < fprops.length()) {
                            fontAliases.push(fprops[fk])
                            fontPaths.push(cssStripQuotes(fvals[fk]))
                            fk = fk + 1
                        }
                    }
                    i = parseInt(res[2])
                }
                continue
            }
            i = i + 1
            continue
        }

        // Selector COMPLETO hasta `(` (condición) o `{` (decls): admite grupos
        // `h1, h2` (una regla por parte) y compuestos `div span` / `.card` /
        // `Button:hover`. El matching del camino interpretado es por TAG exacto
        // (o `*`), así que una parte compuesta simplemente nunca matchea — antes
        // el parser la degradaba al último nombre y CONTAMINABA (p.ej.
        // `section span` estilaba TODOS los span). Corta también en `@`/`}`.
        let selRaw = ""
        while (i < n && src.charAt(i) != "\{" && src.charAt(i) != "}" && src.charAt(i) != "@") {
            // El `(` normalmente abre la CONDICIÓN de la regla y corta el selector.
            // Excepción: una pseudo-clase funcional pegada al nombre —
            // `li:nth-child(2)`— donde el paréntesis es parte del selector. Se
            // distingue por lo que hay justo antes: si el selector termina en
            // `nth-child` (sin espacio de por medio), el paréntesis es suyo.
            if (src.charAt(i) == "(") {
                if (!selRaw.endsWith("nth-child")) { break }
                while (i < n && src.charAt(i) != ")") {
                    selRaw = selRaw + src.charAt(i)
                    i = i + 1
                }
                if (i < n) { selRaw = selRaw + ")"; i = i + 1 }
                continue
            }
            selRaw = selRaw + src.charAt(i)
            i = i + 1
        }
        selRaw = selRaw.trim()
        if (selRaw.length() == 0) {
            if (i < n && src.charAt(i) != "}" && src.charAt(i) != "@") { i = i + 1 }
            continue
        }

        // Condición propia opcional: (var OP literal)
        let ownHas = false
        let ovar = []
        let oop  = []
        let oval = []
        let oneg = []
        let oor  = []
        if (i < n && src.charAt(i) == "(") {
            i = i + 1
            let condStr = ""
            while (i < n && src.charAt(i) != ")") { condStr = condStr + src.charAt(i); i = i + 1; }
            if (i < n) { i = i + 1; }
            let parsed = cssParseCondList(condStr)
            ovar = parsed[0]; oop = parsed[1]; oval = parsed[2]; oneg = parsed[3]; oor = parsed[4]
            // `()` vacío = sin condición (no una condición que nunca pasa).
            ownHas = ovar.length() > 0
        }

        i = cssSkip(src, i)

        // Declaraciones (se leen UNA vez y se duplican por cada parte del grupo,
        // manteniendo el rango contiguo por regla que precomputa Stylesheet).
        let dprops = []
        let dvals  = []
        if (i < n && src.charAt(i) == "\{") {
            let res = cssReadDecls(src, i + 1)
            dprops = res[0]
            dvals  = res[1]
            i = parseInt(res[2])
        }

        // Condición efectiva de la regla = términos heredados (@when/@else) + el propio.
        let terms = cssCopyTerms(curAmbient)
        if (ownHas) { terms.push([false, ovar, oop, oval, oneg, oor]) }

        // Registrar una regla por parte del grupo (arrays planos paralelos)
        let parts = selRaw.split(",")
        let pi = 0
        while (pi < parts.length()) {
            let part = parts[pi].trim()
            if (part.length() > 0) {
                let ruleIndex = selectors.length()
                selectors.push(part)
                hasConds.push(terms.length() > 0)
                condTerms.push(terms)
                let k = 0
                while (k < dprops.length()) {
                    declProps.push(dprops[k])
                    declVals.push(dvals[k])
                    declRuleIdx.push(ruleIndex)
                    k = k + 1
                }
            }
            pi = pi + 1
        }
    }

    let sheet = new Stylesheet(selectors, hasConds, condTerms, declRuleIdx, declProps, declVals, fontAliases, fontPaths)
    sheet.setRaw(src)
    return sheet
}
