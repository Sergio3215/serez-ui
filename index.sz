// serez-ui — librería de UI estilo React para Serez-Code (TUI + GUI)
//
// Requiere el core >= 9.16.0 (ver el README: en uno anterior useEffect falla en
// silencio y los componentes en archivos .szx separados no resuelven).
//
// Modelo React/JSX: componentes que extienden Window, hooks, Virtual DOM
// transparente. Los .szx (JSX) se traducen a .sz con tools/translate.sz — correr
// `sz app.szx` traduce y ejecuta en un paso.
//
// Usage:  import "serez-ui"
//
// ── Window: la clase base y el loop ──────────────────────────────────────────
//   class MiApp:Window { public MiApp() { super() }  public render() { ... } }
//   app.runGui(titulo, w, h)  — ventana nativa    app.runTui()  — terminal
//   Overrides: render() · styleVars() · onKey(evt) · onMouse(evt) · onFrame()
//              renderPanel(id) para ventanas secundarias (openPanel/closePanel)
//
// ── Component: piezas reutilizables ──────────────────────────────────────────
//   class Fila:Component { public render() { ... this.props.x ... } }
//   Recibe props y children; las instancias son EFÍMERAS (una por frame), así que
//   el estado vive en la Window de arriba y baja por props.
//
// ── Hooks ────────────────────────────────────────────────────────────────────
//   useState(initial)        — StateCell con valor inicial
//   useEffect(fn, deps)      — EffectCell; deps [] = sólo al montar, null = siempre
//                              (registrar con this.addEffect(...))
//   memo(render_fn)          — MemoCell para evitar recalcular
//
// ── Componentes built-in (24) ────────────────────────────────────────────────
//   Button Input Textarea Select Dropdown Checkbox RadioGroup Slider ProgressBar
//   Label Link Row Col Image Table Modal Tooltip Toast Chart Switch/Toggle Tabs
//   Collapsible/Accordion FileInput DropZone
//   Más los tags primitivos que el renderer dibuja directo:
//   div, h1, h2, h3, p, span, hr, ul, li, section, form
//   El layout y el estilo son responsabilidad del CSS (.szs).
//
// ── Virtual DOM ──────────────────────────────────────────────────────────────
//   (El VNode lo arma el translator; `h()` es su primitivo y está DEPRECADO —
//    no se escribe a mano, se escribe JSX en un .szx.)
//   VNode                    — nodo del Virtual DOM
//   diff(old, new)           — DETECTOR de cambio, no parcheador incremental:
//                              si devuelve algo, el renderer repinta todo.
//                              Ver el encabezado de src/diff.sz antes de tocarlo.
//
// ── Estilo ───────────────────────────────────────────────────────────────────
//   app.useStylesheet(parseCss(File.read("app.szs")))   — CSS con lógica
//   app.useNativeRenderer(true)                          — motor del core, más rápido

// Virtual DOM
import "src/vnode"
import "src/h"
import "src/patch"
import "src/diff"

// Renderers + eventos — se cargan ANTES de window.sz a propósito: Window.runGui /
// runTui usan GuiRenderer / Renderer / fireEvent, y la resolución de clases en
// serez-code es por importador (el primero que importa un archivo registra sus
// clases globalmente). Si window.sz los importara primero, deduplicaría el import
// de index y rompería el re-export al script del usuario.
import "src/renderer"
import "src/renderer_gui"
import "src/events"

// Window + State (v0.3) — el loop GUI/TUI vive en Window (ver window.sz)
import "src/state"
import "src/effect"
import "src/memo"
import "src/window"

// Built-in components (v0.5)
import "src/components"

// Componentes reutilizables (Window vs Component) + helpers de runtime
import "src/component"

// CSS con lógica (.szs) (v0.6)
import "src/css"

// Layout engine — flexbox (v0.7)
import "src/layout"

// Loops deprecados — shims que redirigen a app.runGui() / app.runTui()
import "src/event_loop"
import "src/gui_event_loop"
